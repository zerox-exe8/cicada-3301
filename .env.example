# =================================================================
# Kyro Discord Bot - Environment Configuration Template
# =================================================================
# Rename this file to `.env` and fill in your values.
# DO NOT share your `.env` file or commit it to GitHub!
# =================================================================

# -----------------------------------------------------------------
# 1. REQUIRED: Discord Bot Credentials
# -----------------------------------------------------------------
# Get your bot token and client ID from https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Your Discord User ID (Developers have bypass & admin command access)
# You can find your ID by enabling Developer Mode in Discord settings,
# right clicking your profile, and clicking "Copy User ID".
DEVELOPER_IDS=your_discord_user_id_here

# -----------------------------------------------------------------
# 2. REQUIRED: PostgreSQL Database Connection
# -----------------------------------------------------------------
# Get a free database from https://supabase.com or https://neon.tech
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example (Supabase pooler): postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=your_postgresql_database_url_here

# -----------------------------------------------------------------
# 3. Bot Settings & Identity
# -----------------------------------------------------------------
BOT_NAME=Kyro
BOT_PREFIX=?
ENVIRONMENT=production
PORT=8080
SYNC_COMMANDS_ON_STARTUP=true

# -----------------------------------------------------------------
# 4. Audio Engine & Lavalink (Music Streaming)
# -----------------------------------------------------------------
# Default connects to Lavalink node (auto-discovery enabled by default)
LAVALINK_URI=http://lava2.kasawa.pro:2334
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_FALLBACK_URIS=
LAVALINK_PUBLIC_LIST_URL=https://lavalink-list.ajieblogs.eu.org/All
LAVALINK_AUTO_DISCOVER=true

# Optional Spotify Integration (Enables Spotify link playback)
# Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# -----------------------------------------------------------------
# 5. AI Engine & Meeting Transcription (Optional)
# -----------------------------------------------------------------
# Google Gemini API Key for meeting summaries & incident analysis
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key for ultra-fast meeting voice transcription (Whisper)
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=

# -----------------------------------------------------------------
# 6. Web Dashboard & External Hosting (Optional)
# -----------------------------------------------------------------
DASHBOARD_TOKEN=
INVITE_URL=
SUPPORT_URL=
