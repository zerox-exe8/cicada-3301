# =========================================================================
# KYRO DISTRIBUTED CORE ENGINE & KYROLINK AUDIO NODE ENVIRONMENT CONFIG
# =========================================================================

# --- Deployment Environment ---
ENV=production
DEBUG=false
WORKER_ID=engine-node-01

# --- Server Binding ---
HOST=0.0.0.0
PORT=8000
AUTH_SECRET_KEY=kyro_super_distributed_secret_change_in_production_key_9999

# --- High Performance Caching (DragonflyDB / Redis) ---
# If offline, the Engine automatically falls back to in-memory TTL caching with zero downtime.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# --- PostgreSQL Database ---
# If offline, the Engine automatically falls back to memory mode without crashing.
POSTGRES_DSN=postgresql://postgres:postgres_secure_pwd@localhost:5432/kyro_engine
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=50

# --- Event Fabric (NATS JetStream) ---
USE_NATS=false
NATS_URL=nats://localhost:4222

# =========================================================================
# KYROLINK ANTI-BAN, UNBLOCKABLE & PROXY CONFIGURATION
# =========================================================================

# Proxy List (Comma-separated or newline-separated)
# Format: http://user:pass@host:port or socks5://user:pass@host:port
# When provided, KyroLink rotates through this pool for YouTube metadata extraction.
# If a proxy encounters a 429 or BotGuard challenge, it is quarantined automatically.
PROXY_LIST=

# Proxy auto-quarantine duration upon 429/403 IP block (in seconds)
PROXY_QUARANTINE_SECONDS=300.0

# YouTube Innertube Client Targets (Bypasses BotGuard and Web PoToken challenges)
# Android mobile clients do not require web poTokens.
YOUTUBE_CLIENTS=android_music,android,ios

# Path to Netscape cookies.txt (Optional fallback for restricted videos)
YOUTUBE_COOKIE_FILE=

# Spotify Metadata API Credentials (Optional: Engine can also resolve anonymously)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Audio Ring Buffer Pre-buffer duration in seconds (Prevents Discord voice stutter/freezing)
AUDIO_PREBUFFER_SECONDS=5
