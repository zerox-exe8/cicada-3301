# ==========================================
# Cicada 3301 Discord Bot - Environment Configuration Template
# ==========================================

# Discord Bot Credentials
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
DEVELOPER_IDS=1082437832087445604

# Bot Defaults
BOT_PREFIX=?
ENVIRONMENT=development
PORT=8080

# Supabase PostgreSQL Cloud Database
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini Intelligence & Summarization Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Dashboard write-access token (optional for local dev).
# Empty = website PATCH allowed locally. Set a long random string in production
# and mirror it as NEXT_PUBLIC_DASHBOARD_TOKEN on the website.
DASHBOARD_TOKEN=
